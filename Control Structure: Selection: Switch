#include <iostream>
using namespace std;

int main(){
    float gpoint;
    char letterGrade;

    cout<<"Input a Letter Grade:";
    cin>>letterGrade;

    switch(letterGrade){
        case 'A': gpoint = 4.0; break;
        case 'B': gpoint=3.0; break;
        case 'C': gpoint=2.0; break;
        case 'D': gpoint=1.0; break;
        case 'F': gpoint=0.0; break;
        default : gpoint=-1.0;
    }
    if (gpoint <0)
    cout<<"You have entered an invalid           letter grade";
    else
    cout<<"The grade point is:"<<gpoint;
    cout<<endl;
return 0;


}
